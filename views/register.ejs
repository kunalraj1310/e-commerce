 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register </title>
    <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" type="image/png" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Poppins', sans-serif; }
        .blob {
            position: absolute;
            filter: blur(80px);
            opacity: 0.4;
            animation: float 10s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(-30px, -40px) scale(1.1); }
            66% { transform: translate(20px, 30px) scale(0.9); }
        }
        .input-animate {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .input-animate:focus {
            transform: translateY(-2px);
            box-shadow: 0 10px 40px -10px rgba(249, 115, 22, 0.3);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .step-dot {
            transition: all 0.4s ease;
        }
        .step-dot.active {
            background: linear-gradient(135deg, #f97316, #fbbf24);
            transform: scale(1.2);
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center px-6 relative overflow-hidden">

    <!-- Animated Background -->
    <div class="blob bg-orange-200 w-[500px] h-[500px] rounded-full -top-32 -right-32"></div>
    <div class="blob bg-amber-200 w-[400px] h-[400px] rounded-full -bottom-32 -left-32" style="animation-delay: -5s;"></div>
    <div class="blob bg-yellow-100 w-96 h-96 rounded-full top-1/3 left-1/2" style="animation-delay: -3s;"></div>

    <% if(error.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 bg-red-50 border-l-4 border-red-500 text-red-700 px-6 py-4 rounded-r-xl shadow-lg z-50 flex items-center gap-3">
        <span class="text-xl">⚠️</span>
        <div>
            <p class="font-semibold">Oops!</p>
            <p class="text-sm"><%= error[0] %></p>
        </div>
    </div>
    <% } %>
    <% if(success.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 bg-green-50 border-l-4 border-green-500 text-green-700 px-6 py-4 rounded-r-xl shadow-lg z-50 flex items-center gap-3">
        <span class="text-xl">✅</span>
        <div>
            <p class="font-semibold">Success</p>
            <p class="text-sm"><%= success[0] %></p>
        </div>
    </div>
    <% } %>

    <a href="/" class="fixed top-6 left-6 bg-white/80 backdrop-blur px-5 py-3 rounded-2xl shadow-lg hover:bg-orange-500 hover:text-white transition-all duration-300 font-medium flex items-center gap-2 border border-gray-100 hover:border-orange-500 z-50">
        ← Back
    </a>

    <div class="w-full max-w-md relative z-10">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-orange-400 to-amber-500 rounded-3xl shadow-xl shadow-orange-500/30 mb-4">
                <span class="text-4xl">✨</span>
            </div>
            <h1 class="text-4xl font-bold text-gray-900">Create Account</h1>
            <p class="text-gray-500 mt-2">Join our community today</p>
        </div>

        <div class="glass-card rounded-3xl shadow-2xl shadow-gray-200/50 p-8 md:p-10">
            
            <form action="/register" method="POST" class="space-y-5">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 ml-1">Full Name</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">👤</span>
                        <input type="text" name="fullname" required placeholder="John Doe"
                            class="input-animate w-full bg-gray-50 border border-gray-200 rounded-2xl pl-12 pr-5 py-4 text-gray-900 placeholder-gray-400 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 ml-1">Email Address</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">📧</span>
                        <input type="email" name="email" required placeholder="you@example.com"
                            class="input-animate w-full bg-gray-50 border border-gray-200 rounded-2xl pl-12 pr-5 py-4 text-gray-900 placeholder-gray-400 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 ml-1">Password</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">🔐</span>
                        <input type="password" name="password" required placeholder="Min 8 characters"
                            class="input-animate w-full bg-gray-50 border border-gray-200 rounded-2xl pl-12 pr-5 py-4 text-gray-900 placeholder-gray-400 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20">
                    </div>
                    <div class="flex gap-1 mt-2 px-1">
                        <div class="h-1 flex-1 rounded-full bg-gray-200"></div>
                        <div class="h-1 flex-1 rounded-full bg-gray-200"></div>
                        <div class="h-1 flex-1 rounded-full bg-gray-200"></div>
                        <div class="h-1 flex-1 rounded-full bg-gray-200"></div>
                    </div>
                </div>

                

                <button type="submit"
                    class="w-full bg-gradient-to-r from-orange-500 to-amber-500 text-white py-4 rounded-2xl font-bold text-lg hover:shadow-xl hover:shadow-orange-500/25 hover:scale-[1.02] transition-all duration-300">
                    Create Account
                </button>

            </form>

            <div class="mt-8 text-center">
                <p class="text-gray-500">
                    Already have an account?
                    <a href="/login" class="text-orange-500 font-bold hover:text-orange-600 transition">Sign In</a>
                </p>
            </div>

            
        </div>
    </div>

</body>
<script>
    setTimeout(() => {
        const msg = document.getElementById("flash-message");
        if (msg) msg.remove();
    }, 3000);
</script>   
</html>