<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BagStore</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 overflow-x-hidden">

    <section class="min-h-screen flex items-center px-6 lg:px-20">

        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">

            <!-- Left Content -->
            <div>

                <span class="bg-orange-100 text-orange-600 px-4 py-2 rounded-full text-sm font-semibold">
                    Premium Collection 2026
                </span>

                <h1 class="text-5xl md:text-7xl font-bold mt-6 leading-tight">
                    Carry Your
                    <span class="text-orange-500">
                        Style
                    </span>
                    Everywhere.
                </h1>

                <p class="mt-6 text-lg text-gray-600 max-w-xl">
                    Discover premium backpacks, travel bags, handbags and
                    lifestyle accessories designed for comfort, elegance
                    and everyday adventures.
                </p>

                <div class="flex gap-4 mt-10">

                    <a href="/login">
                        <button class="bg-black text-white px-8 py-4 rounded-xl hover:bg-gray-800 transition">
                            Shop Now
                        </button>
                    </a>

                    <a href="/login">
                        <button class="border border-black px-8 py-4 rounded-xl hover:bg-black hover:text-white transition">
                            Explore Collection
                        </button>
                    </a>

                </div>

            </div>

            <!-- Right Image -->
            <div class="relative">

                <div class="absolute -top-10 -left-10 w-48 h-48 bg-orange-200 rounded-full blur-3xl opacity-50"></div>

                <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-yellow-200 rounded-full blur-3xl opacity-50"></div>

                <img
                    src="https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=1200"
                    alt="Luxury Bag"
                    class="relative rounded-3xl shadow-2xl w-full h-[650px] object-cover"
                >

            </div>

        </div>

    </section>

    <!-- Visual Features -->
    <section class="pb-24 px-6 lg:px-20">

        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8">

            <div class="bg-white rounded-3xl p-8 shadow-sm text-center">
                <div class="text-5xl mb-4">🎒</div>
                <h3 class="text-xl font-bold">Premium Quality</h3>
                <p class="text-gray-500 mt-3">
                    Crafted with durable and stylish materials.
                </p>
            </div>

            <div class="bg-white rounded-3xl p-8 shadow-sm text-center">
                <div class="text-5xl mb-4">✨</div>
                <h3 class="text-xl font-bold">Modern Designs</h3>
                <p class="text-gray-500 mt-3">
                    Minimal and fashionable bags for every lifestyle.
                </p>
            </div>

            <div class="bg-white rounded-3xl p-8 shadow-sm text-center">
                <div class="text-5xl mb-4">🚚</div>
                <h3 class="text-xl font-bold">Fast Delivery</h3>
                <p class="text-gray-500 mt-3">
                    Quick and secure shipping on every order.
                </p>
            </div>

        </div>

        <div class="text-center mt-16">
            <a href="/login">
                <button class="bg-orange-500 hover:bg-orange-600 text-white px-10 py-4 rounded-xl text-lg font-semibold transition">
                    Get Started
                </button>
            </a>
        </div>

    </section>

</body>
</html>