<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Profile Picture</title>
    <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" type="image/png" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass-nav {
            background: rgba(24, 24, 27, 0.8);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .glow-ring {
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.3), 0 0 60px rgba(59, 130, 246, 0.2);
        }
        .upload-zone {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(147, 51, 234, 0.1));
            border: 2px dashed rgba(59, 130, 246, 0.3);
            transition: all 0.4s ease;
        }
        .upload-zone:hover {
            border-color: rgba(59, 130, 246, 0.6);
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(147, 51, 234, 0.15));
            transform: translateY(-2px);
        }
        .avatar-float {
            animation: avatarFloat 6s ease-in-out infinite;
        }
        @keyframes avatarFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        .btn-gradient {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            transition: all 0.3s ease;
        }
        .btn-gradient:hover {
            box-shadow: 0 10px 40px -10px rgba(59, 130, 246, 0.5);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen relative overflow-hidden">

    <!-- Background Effects -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Navbar -->
    <nav class="glass-nav sticky top-0 z-50 px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center font-bold text-sm">
                    S
                </div>
                <span class="font-bold text-lg">STACH</span>
            </div>
            <a href="/profile/<%= user._id %>"
                class="inline-flex items-center gap-2 bg-zinc-800/80 hover:bg-zinc-700 px-4 py-2.5 rounded-xl transition border border-zinc-700 hover:border-zinc-600">
                ← Back to Profile
            </a>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="flex justify-center items-center mt-12 px-4 pb-12">
        <div class="w-full max-w-lg">
            
            <!-- Header -->
            <div class="text-center mb-10">
                <h1 class="text-4xl font-bold bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent mb-3">
                    Upload Photo
                </h1>
                <p class="text-zinc-400">Choose a new profile picture for your account</p>
            </div>

            <!-- Card -->
            <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 md:p-10 shadow-2xl shadow-black/50">
                
                <!-- Avatar Preview -->
                <div class="flex justify-center mb-8">
                    <div class="relative avatar-float">
                        <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full blur-xl opacity-50"></div>
                        <img src="<%= user.profilepic ? `data:image/jpeg;base64,${user.profilepic.toString('base64')}` : 'https://ui-avatars.com/api/?name=User&background=18181b&color=ffffff&size=200' %>"
                            alt="Profile Picture"
                            class="relative w-40 h-40 rounded-full object-cover border-4 border-zinc-800 glow-ring">
                        
                        <!-- Camera Icon Badge -->
                        <div class="absolute bottom-2 right-2 w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center shadow-lg border-4 border-zinc-900">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Upload Form -->
                <form action="/profile/upload/<%=user._id%>" method="POST" enctype="multipart/form-data" class="space-y-6">

                    <div>
                        <label class="block text-sm font-medium text-zinc-400 mb-3 uppercase tracking-wider text-xs">
                            Select Image
                        </label>
                        
                        <div class="upload-zone relative rounded-2xl p-8 text-center cursor-pointer group">
                            <input type="file" name="profilePic" accept="image/*" required
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                            
                            <div class="pointer-events-none space-y-3">
                                <div class="w-14 h-14 bg-zinc-800 rounded-2xl flex items-center justify-center mx-auto group-hover:scale-110 transition-transform duration-300">
                                    <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                    </svg>
                                </div>
                                <p class="text-zinc-300 font-medium">Click to upload or drag & drop</p>
                                <p class="text-zinc-500 text-sm">JPG, PNG up to 5MB</p>
                            </div>
                        </div>
                    </div>

                    <!-- Selected File Name Display -->
                    <div id="file-name" class="hidden bg-zinc-800/50 rounded-xl p-3 flex items-center gap-3 border border-zinc-700">
                        <span class="text-2xl">📄</span>
                        <span class="text-sm text-zinc-300 truncate flex-1" id="file-name-text"></span>
                        <button type="button" onclick="clearFile()" class="text-zinc-500 hover:text-red-400 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <button type="submit"
                        class="btn-gradient w-full text-white py-4 rounded-2xl font-bold text-lg flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                        </svg>
                        Upload Picture
                    </button>

                </form>
            </div>

            <!-- Tips -->
            <div class="mt-6 bg-zinc-900/50 border border-zinc-800 rounded-2xl p-6">
                <h3 class="text-sm font-semibold text-zinc-400 mb-3 uppercase tracking-wider">💡 Tips</h3>
                <ul class="space-y-2 text-sm text-zinc-500">
                    <li class="flex items-start gap-2">
                        <span class="text-blue-400 mt-0.5">•</span>
                        Use a square image for best results
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-blue-400 mt-0.5">•</span>
                        Minimum resolution: 200x200 pixels
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-blue-400 mt-0.5">•</span>
                        Face should be clearly visible
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <script>
        // Show selected filename
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                document.getElementById('file-name-text').textContent = file.name;
                document.getElementById('file-name').classList.remove('hidden');
            }
        });

        function clearFile() {
            document.querySelector('input[type="file"]').value = '';
            document.getElementById('file-name').classList.add('hidden');
        }
    </script>

</body>
</html>