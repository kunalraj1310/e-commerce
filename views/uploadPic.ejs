<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Profile Picture</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="px-6 py-5 border-b border-zinc-800">
        <a href="/profile/<%= user._id %>"
            class="inline-flex items-center gap-2 bg-zinc-800 px-4 py-2 rounded-lg hover:bg-zinc-700 transition">
            ← Back to Profile
        </a>
    </nav>

    <!-- Upload Card -->
    <div class="flex justify-center items-center mt-16 px-4">

        <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-2xl p-8">

            <h1 class="text-3xl font-bold text-center mb-8">
                Upload Profile Picture
            </h1>

            <!-- Preview Image -->
            <div class="flex justify-center mb-6">
                    <img
                    src="<%= user.profilepic
                        ? `data:image/jpeg;base64,${user.profilepic.toString('base64')}`
                        : 'https://ui-avatars.com/api/?name=User&background=18181b&color=ffffff&size=200' %>"
                    alt="Profile Picture"
                    class="w-36 h-36 rounded-full object-cover border-4 border-zinc-700">
                                
            </div>

            <!-- Upload Form -->
            <form action="/profile/upload/<%=user._id%>" method="POST" enctype="multipart/form-data">

                <label class="block mb-2 text-zinc-300">
                    Choose an Image
                </label>

                <input
                    type="file"
                    name="profilePic"
                    accept="image/*"
                    required
                    class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-3 mb-6 text-white">

                <button
                    type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 py-3 rounded-lg font-semibold transition">
                    Upload Picture
                </button>

            </form>

        </div>

    </div>

</body>
</html>