<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-950 min-h-screen text-white py-10 px-4">

    <a href="/shop"
   class="text-zinc-300 hover:text-white font-medium transition-colors duration-300">
    ← Back to Shop
    </a>

    <div class="max-w-6xl mx-auto">

        <div class="mb-10">
            <h1 class="text-4xl font-bold">
                My Orders
            </h1>
            <p class="text-zinc-400 mt-2">
                View and track all your purchases.
            </p>
        </div>
        <%if(user.orders.length === 0 ){%>
            <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-12 text-center">
                <h2 class="text-2xl font-bold text-white">
                    No Orders Found
                </h2>

                <p class="text-zinc-400 mt-2">
                    You haven't placed any orders yet.
                </p>

                <a href="/shop"
                class="inline-block mt-6 px-5 py-3 bg-white text-black rounded-xl font-semibold">
                    Continue Shopping
                </a>
            </div>
        <%}else{%>
            <%user.orders.forEach(function(order){%>
             <div class="space-y-6">

                
            <% let amount = Math.round((Number(order.totalAmount) + 500)/1.18) %>
            <% const tax = Math.round(0.18* Number(amount)) %>
            <% let shipping = Math.round(Number(amount)/40) %> 
            <% if(Number(order.totalAmount) >= 4220){ %>
                <% shipping = 0 %>
                <% amount = amount %>
            <% }else{ %>
                <% shipping = shipping %>
                <% amount = Math.round(0.97*amount) %>
            <%} %> 
            <!-- Order 1
             <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-6"> -->

                <!-- Top -->
                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">

                    <div>
                        <p class="text-zinc-500 text-sm">
                            ORDER ID
                        </p>

                        <h2 class="font-mono font-semibold text-lg">
                           <%= order._id%>
                        </h2>
                    </div>

                    <span class="bg-green-500/15 text-green-400 px-4 py-2 rounded-full text-sm font-medium w-fit">
                        Delivered
                    </span>

                </div>

                <!-- Products -->
                 <% products.forEach(function(product){ %>
                    <div class="flex items-center gap-4 mt-6">

                    <img
                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                        class="w-20 h-20 rounded-xl object-cover"
                    >

                    <div>
                        <p class="font-semibold">
                          <%= products.length%>  
                        </p>

                        <p class="text-zinc-400 text-sm">
                            <%= product.name%>
                        </p>
                    </div>

                    </div>
                 <%})%>
                
                    <div class="mt-6 bg-zinc-800 rounded-2xl p-4">

                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold text-white">
                                Products
                            </h3>

                            <span class="text-sm text-zinc-400">
                                <%= products.length %> Items
                            </span>
                        </div>

                        <div class="flex items-center gap-3">

                            <% products.slice(0,3).forEach(product => { %>

                                <img
                                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="<%= product.name %>"
                                    class="w-16 h-16 rounded-xl object-cover border border-zinc-700"
                                >

                            <% }) %>

                            <% if(products.length > 3){ %>
                                <div class="w-16 h-16 rounded-xl bg-zinc-700 flex items-center justify-center text-sm font-semibold">
                                    +<%= products.length - 3 %>
                                </div>
                            <% } %>

                        </div>

                        <div class="mt-4">
                            <p class="text-sm text-zinc-300 truncate">
                                <%= products.map(p => p.name).join(", ") %>
                            </p>
                        </div>

                    </div>
                <!-- Address -->
                <div class="mt-6 bg-zinc-800 rounded-2xl p-4">

                    <p class="text-zinc-400 text-sm mb-1">
                        Shipping Address
                    </p>

                    <p class="text-sm">
                        <%= order.address%>
                    </p>

                </div>

                <!-- Payment Summary -->
                <div class="mt-6 grid md:grid-cols-2 gap-6">

                    <div class="bg-zinc-800 rounded-2xl p-4">

                        <h3 class="font-semibold mb-4">
                            Payment Breakdown
                        </h3>

                        <div class="space-y-2 text-sm">

                            <div class="flex justify-between">
                                <span class="text-zinc-400">
                                    Subtotal
                                </span>

                                <span>
                                   <%= amount %>
                                </span>
                            </div>

                            <div class="flex justify-between">
                                <span class="text-zinc-400">
                                    Shipping
                                </span>

                                <span class="text-green-400">
                                    <%= shipping%>
                                </span>
                            </div>

                            <div class="flex justify-between">
                                <span class="text-zinc-400">
                                    Tax
                                </span>

                                <span>
                                    ₹<%= tax %>
                                </span>
                            </div>
                             <div class="flex justify-between">
                                <span class="text-zinc-400">
                                    Discount
                                </span>

                                <span>
                                    -₹500
                                </span>
                            </div>

                            <hr class="border-zinc-700">

                            <div class="flex justify-between font-bold text-lg">
                                <span>Total Paid</span>
                                <span>₹<%= order.totalAmount %></span>
                            </div>

                        </div>

                    </div>

                    <!-- Payment Method -->
                    <div class="bg-zinc-800 rounded-2xl p-4 flex flex-col justify-center">

                        <p class="text-zinc-400 text-sm mb-2">
                            Payment Method
                        </p>

                        <span class="bg-black border border-zinc-700 px-4 py-3 rounded-xl w-fit">
                            Cash On Delivery
                        </span>

                        <p class="text-green-400 text-sm mt-4">
                            ✓ Payment Successful
                        </p>

                    </div>

                </div>

                <!-- Footer -->
                <div class="flex justify-end mt-6">

                </div>

            </div>

            <!-- Duplicate this card for every order -->

        </div>
        <%})%>
        <%}%>
        <!-- ORDER CARD -->
       

    </div>

</body>
</html>