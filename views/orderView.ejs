<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-950 min-h-screen text-white">

    <!-- Header -->
    <div class="sticky top-0 z-50 bg-zinc-950/90 backdrop-blur border-b border-zinc-800">
        <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">

            <a
                href="/shop"
                class="text-zinc-400 hover:text-white transition font-medium"
            >
                ← Back to Shop
            </a>

            <div class="text-right">
                <h1 class="text-xl md:text-2xl font-bold">
                    My Orders
                </h1>

                <p class="text-zinc-500 text-sm">
                    <%= user.orders.length %> Orders
                </p>
            </div>

        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-8">

        <% if(user.orders.length === 0){ %>

            <!-- Empty State -->
            <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-12 text-center">

                <div class="text-7xl mb-6">📦</div>

                <h2 class="text-3xl font-bold">
                    No Orders Yet
                </h2>

                <p class="text-zinc-400 mt-3 max-w-md mx-auto">
                    Looks like you haven't purchased anything yet.
                    Start exploring products and place your first order.
                </p>

                <a
                    href="/shop"
                    class="inline-flex items-center gap-2 mt-8 px-6 py-3 bg-white text-black rounded-xl font-semibold hover:bg-zinc-200 transition"
                >
                    Continue Shopping →
                </a>

            </div>

        <% } else { %>

            <div class="space-y-8">

                <% user.orders.forEach(function(order){ %>

                    <% let amount = Math.round((Number(order.totalAmount) + 500) / 1.18) %>
                    <% const tax = Math.round(0.18 * Number(amount)) %>
                    <% let shipping = Math.round(Number(amount) / 40) %>

                    <% if(Number(order.totalAmount) >= 4220){ %>
                        <% shipping = 0 %>
                    <% } else { %>
                        <% amount = Math.round(0.97 * amount) %>
                    <% } %>

                    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl overflow-hidden shadow-lg hover:border-zinc-700 transition duration-300">

                        <!-- Order Header -->
                        <div class="p-6 border-b border-zinc-800">

                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

                                <div>
                                    <p class="text-zinc-500 text-xs uppercase tracking-[3px]">
                                        Order ID
                                    </p>

                                    <h2 class="text-lg md:text-xl font-semibold mt-1">
                                        #<%= order._id %>
                                    </h2>

                                    <p class="text-zinc-400 text-sm mt-2">
                                        Successfully delivered and completed.
                                    </p>
                                </div>

                                <div class="flex flex-wrap gap-3 items-center">

                                    <div class="bg-green-500/10 text-green-400 px-4 py-2 rounded-full text-sm font-medium">
                                        ✓ Delivered
                                    </div>

                                    <div class="bg-zinc-800 px-4 py-2 rounded-full text-sm font-semibold">
                                        ₹<%= order.totalAmount %>
                                    </div>

                                    <button
                                        onclick="toggleOrder('<%= order._id %>')"
                                        class="px-4 py-2 bg-white text-black rounded-xl font-medium hover:bg-zinc-200 transition"
                                    >
                                        View Details
                                    </button>

                                </div>

                            </div>

                        </div>

                        <!-- Ordered Products -->
                        <div class="p-6">

                            <div class="bg-zinc-950 border border-zinc-800 rounded-2xl p-5">

                                <div class="flex items-center justify-between mb-5">

                                    <h3 class="font-semibold text-lg">
                                        Ordered Products
                                    </h3>

                                    <span class="text-zinc-400 text-sm">
                                        <%= order.products.reduce((total, item) => total + item.quantity, 0) %>
                                        Item<%= order.products.reduce((total, item) => total + item.quantity, 0) > 1 ? "s" : "" %>
                                    </span>

                                </div>

                                <div class="space-y-4">

                                    <% order.products.forEach(item => { %>

                                        <div class="flex items-center justify-between">

                                            <div class="flex items-center gap-4">

                                                <img
                                                    src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                                                    alt="<%= item.product.name %>"
                                                    class="w-16 h-16 rounded-xl object-cover border border-zinc-700"
                                                >

                                                <div>

                                                    <p class="font-medium">
                                                        <%= item.product.name %>
                                                    </p>

                                                    <p class="text-zinc-400 text-sm">
                                                        Quantity: <%= item.quantity %>
                                                    </p>

                                                </div>

                                            </div>

                                            <p class="font-semibold">
                                                ₹<%= item.product.price %>
                                            </p>

                                        </div>

                                    <% }) %>

                                </div>

                            </div>

                        </div>

                        <!-- Address -->
                        <div class="px-6 pb-6">

                            <div class="bg-zinc-800 rounded-2xl p-4">

                                <p class="text-zinc-500 text-xs uppercase tracking-wider mb-2">
                                    Shipping Address
                                </p>

                                <p class="text-sm leading-relaxed text-zinc-200">
                                    <%= order.address %>
                                </p>

                            </div>

                        </div>

                        <!-- Expandable Details -->
                        <div
                            id="order-<%= order._id %>"
                            class="hidden border-t border-zinc-800 bg-zinc-950"
                        >

                            <div class="p-6 grid lg:grid-cols-2 gap-6">

                                <!-- Payment Breakdown -->
                                <div class="bg-zinc-900 rounded-2xl p-5 border border-zinc-800">

                                    <h3 class="font-semibold text-lg mb-5">
                                        Payment Breakdown
                                    </h3>

                                    <div class="space-y-3">

                                        <div class="flex justify-between">
                                            <span class="text-zinc-400">Subtotal</span>
                                            <span>₹<%= amount %></span>
                                        </div>

                                        <div class="flex justify-between">
                                            <span class="text-zinc-400">Shipping</span>

                                            <span class="<%= shipping === 0 ? 'text-green-400' : '' %>">
                                                <%= shipping === 0 ? 'FREE' : `₹${shipping}` %>
                                            </span>
                                        </div>

                                        <div class="flex justify-between">
                                            <span class="text-zinc-400">Tax</span>
                                            <span>₹<%= tax %></span>
                                        </div>

                                        <div class="flex justify-between">
                                            <span class="text-zinc-400">Discount</span>

                                            <span class="text-green-400">
                                                -₹500
                                            </span>
                                        </div>

                                        <hr class="border-zinc-700">

                                        <div class="flex justify-between text-lg font-bold">
                                            <span>Total Paid</span>
                                            <span>₹<%= order.totalAmount %></span>
                                        </div>

                                    </div>

                                </div>

                                <!-- Payment Information -->
                                <div class="bg-zinc-900 rounded-2xl p-5 border border-zinc-800">

                                    <h3 class="font-semibold text-lg mb-5">
                                        Payment Information
                                    </h3>

                                    <div class="space-y-4">

                                        <div>
                                            <p class="text-zinc-500 text-sm">
                                                Method
                                            </p>

                                            <div class="mt-2 bg-zinc-800 border border-zinc-700 px-4 py-3 rounded-xl inline-block">
                                                Cash On Delivery
                                            </div>
                                        </div>

                                        <div>
                                            <p class="text-zinc-500 text-sm">
                                                Status
                                            </p>

                                            <p class="text-green-400 mt-2 font-medium">
                                                ✓ Payment Successful
                                            </p>
                                        </div>

                                        <div>
                                            <p class="text-zinc-500 text-sm">
                                                Order Status
                                            </p>

                                            <p class="text-green-400 mt-2 font-medium">
                                                ✓ Delivered
                                            </p>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

    <script>
        function toggleOrder(id) {
            const element = document.getElementById(`order-${id}`);
            element.classList.toggle("hidden");
        }
    </script>

</body>
</html>