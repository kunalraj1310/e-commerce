<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Product</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">

    <div class="max-w-3xl mx-auto py-10 px-4">

        <div class="bg-white shadow-xl rounded-2xl p-8">

            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">
                        Update Product
                    </h1>
                    <p class="text-gray-500">
                        Edit product information
                    </p>
                </div>

                <a href="/owner/admin"
                   class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
                    Back
                </a>
            </div>

            <form
                action="/products/update/<%= product._id %>"
                method="POST"
                enctype="multipart/form-data"
                class="space-y-6"
            >

                <!-- Current Image -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Current Image
                    </label>

                    <img
                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                        class="w-40 h-40 object-cover rounded-xl border"
                    >
                </div>

                <!-- Name -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Product Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= product.name %>"
                        required
                        class="w-full border rounded-xl px-4 py-3 focus:ring-2 focus:ring-black outline-none"
                    >
                </div>

                <!-- Price -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Price
                    </label>

                    <input
                        type="number"
                        name="price"
                        value="<%= product.price %>"
                        required
                        class="w-full border rounded-xl px-4 py-3 focus:ring-2 focus:ring-black outline-none"
                    >
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Discount
                    </label>

                    <input
                        type="text"
                        name="discount"
                        value="<%= product.discount %>"
                        required
                        class="w-full border rounded-xl px-4 py-3 focus:ring-2 focus:ring-black outline-none"
                    >
                </div>


                <!-- New Image -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Upload New Image (Optional)
                    </label>

                    <input
                        type="file"
                        name="image"
                        accept="image/*"
                        class="w-full border rounded-xl px-4 py-3"
                    >
                </div>

                <!-- Buttons -->
                <div class="flex gap-4">

                    <button
                        type="submit"
                        class="flex-1 bg-black text-white py-3 rounded-xl font-semibold hover:bg-gray-800 transition"
                    >
                        Update Product
                    </button>

                    <a
                        href="/owner/admin"
                        class="flex-1 text-center bg-gray-200 py-3 rounded-xl font-semibold hover:bg-gray-300 transition"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>