<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-950 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="bg-zinc-900 border-b border-zinc-800 px-8 py-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold">STACH</h1>
        <a href="/cart" class="text-zinc-300 hover:text-white">Back to Cart</a>
    </nav>

    <div class="max-w-7xl mx-auto px-5 py-10">

        <h2 class="text-4xl font-bold mb-8">Checkout</h2>

        <div class="grid lg:grid-cols-3 gap-8">

            <!-- Shipping Form -->
            <div class="lg:col-span-2 bg-zinc-900 rounded-2xl p-6 border border-zinc-800">

                <h3 class="text-2xl font-semibold mb-6">
                    Shipping Information
                </h3>

                <form action="/order/<%= user._id%>" method="POST" class="space-y-5">

                    <div>
                        <label class="block mb-2 text-zinc-300">
                            Full Name
                        </label>
                        <input
                            type="text"
                            value= <%= user.fullname%>
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-blue-500"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 text-zinc-300">
                            Email
                        </label>
                        <input
                            type="email"
                            value=<%= user.email%>
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-blue-500"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 text-zinc-300">
                            Phone Number
                        </label>
                        <input
                            type="text"
                            placeholder="Phone Number"
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-blue-500"
                        >
                    </div>

                    <div>
                        <label class="block mb-2 text-zinc-300">
                            Address
                        </label>
                        <textarea
                            rows="4"
                            placeholder="Address"
                            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-blue-500"
                        ></textarea>
                    </div>

                    <div class="grid md:grid-cols-2 gap-5">

                        <div>
                            <label class="block mb-2 text-zinc-300">
                                City
                            </label>
                            <input
                                type="text"
                                placeholder="City"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3"
                            >
                        </div>

                        <div>
                            <label class="block mb-2 text-zinc-300">
                                Pincode
                            </label>
                            <input
                                type="text"
                                placeholder="Pincode"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3"
                            >
                        </div>

                    </div>

                    <div>
                        <label class="block mb-3 text-zinc-300">
                            Payment Method
                        </label>

                        <div class="space-y-3">

                            <label class="flex items-center gap-3 bg-zinc-800 p-4 rounded-lg cursor-pointer">
                                <input type="radio" name="payment" checked>
                                <span>Cash on Delivery (COD)</span>
                            </label>

                            <!-- <label class="flex items-center gap-3 bg-zinc-800 p-4 rounded-lg cursor-pointer">
                                <input type="radio" name="payment">
                                <span>UPI Payment</span>
                            </label>

                            <label class="flex items-center gap-3 bg-zinc-800 p-4 rounded-lg cursor-pointer">
                                <input type="radio" name="payment">
                                <span>Credit / Debit Card</span>
                            </label> -->

                        </div>
                    </div>
                    <button
                    type="submit"
                    class="w-full mt-6 bg-white text-black py-3 rounded-xl font-semibold text-lg hover:bg-zinc-200 transition duration-200"
                >
                    Place Order
                </button>

                </form>

            </div>

            <!-- Order Summary -->
            <div class="bg-zinc-900 rounded-2xl p-6 border border-zinc-800 h-fit sticky top-5">

                <h3 class="text-2xl font-semibold mb-6">
                    Order Summary
                </h3>
                                    <% user.cart.forEach(function(item) { %>

                        <div class="flex gap-4 mb-5">

                            <img
                                src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                                class="w-20 h-20 object-cover rounded-lg"
                                alt="<%= item.product.name %>"
                            >

                            <div>
                                <h4 class="font-semibold">
                                    <%= item.product.name %>
                                </h4>

                                <p class="text-zinc-400 text-sm">
                                    Quantity: <%= item.quantity %>
                                </p>

                                <p class="font-bold">
                                    ₹<%= item.product.price * item.quantity %>
                                </p>
                            </div>

                        </div>

                    <% }) %>
                <hr class="border-zinc-800 my-5">

                <div class="mt-6 space-y-4">

                    <div class="flex items-center justify-between text-zinc-300">
                        <span>Subtotal</span>
                        <span class="font-medium">₹<%= total %></span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-300">
                        <span>Shipping</span>
                        <span class="font-medium text-green-400">
                            ₹<%= shipping %>
                        </span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-300">
                        <span>Tax</span>
                        <span class="font-medium">
                            ₹<%= tax %>
                        </span>
                    </div>

                    <div class="flex items-center justify-between text-zinc-300">
                        <span>Discount</span>
                        <span class="font-medium text-green-400">
                            -₹500
                        </span>
                    </div>

                </div>

                <hr class="border-zinc-800 my-6">

                <div class="flex items-center justify-between">
                    <span class="text-xl font-bold text-white">
                        Total
                    </span>

                    <span class="text-2xl font-bold text-white">
                        ₹<%= (total + shipping + tax) - 500 %>
                    </span>
                </div>

                
            </div>

        </div>

    </div>

</body>
</html>