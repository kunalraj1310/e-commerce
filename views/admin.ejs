<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

<div class="max-w-6xl mx-auto p-8">

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-bold">Admin Dashboard</h1>
            <p class="text-gray-500">Manage your products</p>
        </div>

        <a href="/products/Create"
           class="bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition">
            + Create Product
        </a>
    </div>

    <!-- Products Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% products.forEach((product)=>{ %>
             <div class="group relative bg-white rounded-2xl shadow-md overflow-hidden">

            <img
                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                class="w-full h-60 object-cover"
            >

            <div class="p-5">
                <h2 class="font-bold text-lg">
                    <%= product.name %>
                </h2>

                <div class="mt-2">
                   <%if(product.discount > 0){%>
                     <span class="line-through text-gray-400">
                        ₹<%= product.price %>
                    </span>

                    <span class="text-green-600 font-bold ml-2">
                        ₹<%= Math.round(Number(product.price) - Number(product.discount))%>
                    </span>
                   <%}else{%>
                    <span class="text-gray-400">
                        ₹<%= product.price %>
                    </span>
                   <%}%>
                </div>
            </div>

            <div class="absolute inset-0 bg-black/60 flex items-center justify-center gap-4 opacity-0 group-hover:opacity-100 transition duration-300">

                <a href="/product/<%= product._id %>"
                   class="bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600">
                    ✏ Update
                </a>

                 <a href="/product/delete/<%= product._id %>">
                <button
                    onclick="return confirmDelete()"
                    class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700">
                    🗑 Delete
                </button>
                </a>
            </div>

        </div>
        <% }) %>

    </div>

</div>

</body>
<script>
    function confirmDelete() {
        return confirm("Are you sure you want to delete this product?");
    }
</script>
</html>