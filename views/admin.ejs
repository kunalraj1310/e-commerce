<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/png" href="/images/logo.png">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    * { font-family: 'Inter', sans-serif; }
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .hover-lift {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hover-lift:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }
    .action-overlay {
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
    }
    .stock-badge {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .7; }
    }
</style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-gray-50 to-stone-100 min-h-screen">

    <!-- Top Navigation -->
    <nav class="sticky top-0 z-50 glass-card border-b border-gray-200/50 px-6 py-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-lg">
                    A
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Admin Dashboard</h1>
                    <p class="text-xs text-gray-500">Manage your products</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm text-gray-500 bg-white/80 px-3 py-1.5 rounded-full border border-gray-200">
                    <%= products.length %> Products
                </span>
                <a href="/products/Create"
                   class="group relative bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-xl hover:shadow-xl hover:shadow-indigo-500/25 transition-all duration-300 flex items-center gap-2 overflow-hidden">
                    <span class="relative z-10">+ Create Product</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </a>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto p-8">
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Total Products</p>
                        <p class="text-3xl font-bold text-gray-900 mt-1"><%= products.length %></p>
                    </div>
                    <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-2xl">📦</div>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">In Stock</p>
                        <p class="text-3xl font-bold text-green-600 mt-1">
                            <%= products.filter(p => p.stock === 'Instock').length %>
                        </p>
                    </div>
                    <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-2xl">✅</div>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">On Sale</p>
                        <p class="text-3xl font-bold text-orange-600 mt-1">
                            <%= products.filter(p => p.discount > 0).length %>
                        </p>
                    </div>
                    <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center text-2xl">🏷️</div>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 font-medium">Revenue</p>
                        <p class="text-3xl font-bold text-indigo-600 mt-1">₹<%= products.reduce((sum, p) => sum + Number(p.price), 0).toLocaleString() %></p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center text-2xl">💰</div>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% products.forEach((product)=>{ %>
            <div class="group relative bg-white rounded-3xl shadow-sm hover-lift overflow-hidden border border-gray-100">
                
                <!-- Image Container -->
                <div class="relative h-72 overflow-hidden">
                    <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                         alt="<%= product.name %>">
                    
                    <!-- Stock Badge -->
                    <div class="absolute top-4 left-4">
                        <% if(product.stock === 'Instock'){ %>
                            <span class="bg-green-500/90 backdrop-blur text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg">
                                ✓ In Stock
                            </span>
                        <% } else { %>
                            <span class="bg-red-500/90 backdrop-blur text-white px-3 py-1 rounded-full text-xs font-semibold shadow-lg stock-badge">
                                ✗ Out of Stock
                            </span>
                        <% } %>
                    </div>

                    <% if(product.discount > 0){ %>
                    <div class="absolute top-4 right-4">
                        <span class="bg-gradient-to-r from-orange-500 to-red-500 text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg">
                            -₹<%= product.discount %>
                        </span>
                    </div>
                    <% } %>

                    <!-- Hover Overlay -->
                    <div class="absolute inset-0 action-overlay opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col items-center justify-end pb-8 gap-3">
                        
                        <div class="flex gap-3 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                            <a href="/product/<%= product._id %>"
                               class="bg-white text-gray-900 px-5 py-2.5 rounded-xl font-semibold hover:bg-gray-100 transition shadow-lg flex items-center gap-2">
                                ✏ Update
                            </a>
                            <a href="/product/delete/<%= product._id %>"
                               onclick="return confirmDelete()"
                               class="bg-red-500 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-red-600 transition shadow-lg flex items-center gap-2">
                                🗑 Delete
                            </a>
                        </div>
                        
                        <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-75">
                            <% if(product.stock === 'Instock'){ %>
                                <a href="/outstock/<%= product._id %>"
                                   class="bg-amber-500 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-amber-600 transition shadow-lg flex items-center gap-2">
                                    📤 Mark Out of Stock
                                </a>
                            <% } else { %>
                                <a href="/instock/<%= product._id %>"
                                   class="bg-green-500 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-green-600 transition shadow-lg flex items-center gap-2">
                                    📥 Mark In Stock
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="p-6">
                    <h2 class="font-bold text-lg text-gray-900 mb-2 line-clamp-1">
                        <%= product.name %>
                    </h2>
                    
                    <div class="flex items-end gap-3">
                        <% if(product.discount > 0){ %>
                            <span class="text-2xl font-bold text-gray-900">
                                ₹<%= Math.round(Number(product.price) - Number(product.discount))%>
                            </span>
                            <span class="text-sm text-gray-400 line-through mb-1">
                                ₹<%= product.price %>
                            </span>
                            <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-lg font-semibold mb-1">
                                <%= Math.round((product.discount / product.price) * 100) %>% OFF
                            </span>
                        <% } else { %>
                            <span class="text-2xl font-bold text-gray-900">
                                ₹<%= product.price %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>

        <% if(products.length === 0){ %>
        <div class="text-center py-24">
            <div class="text-8xl mb-6">🛍️</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">No Products Yet</h3>
            <p class="text-gray-500 mb-8">Start by creating your first product</p>
            <a href="/products/Create" class="inline-flex items-center gap-2 bg-indigo-600 text-white px-8 py-4 rounded-2xl font-semibold hover:bg-indigo-700 transition shadow-lg">
                + Create Your First Product
            </a>
        </div>
        <% } %>

    </div>

</body>
<script>
    function confirmDelete() {
        return confirm("Are you sure you want to delete this product?");
    }
</script>
</html>