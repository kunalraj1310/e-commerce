<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" type="image/png" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass-nav {
            background: rgba(9, 9, 11, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .profile-card {
            background: linear-gradient(180deg, rgba(39, 39, 42, 0.6), rgba(24, 24, 27, 0.8));
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .avatar-glow {
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2), 0 0 60px rgba(59, 130, 246, 0.15);
        }
        .avatar-float {
            animation: avatarFloat 6s ease-in-out infinite;
        }
        @keyframes avatarFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .stat-card {
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.8), rgba(24, 24, 27, 0.6));
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }
        .btn-primary {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(34, 197, 94, 0.4);
        }
        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            transition: all 0.3s ease;
        }
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(239, 68, 68, 0.4);
        }
        .btn-secondary {
            background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .btn-secondary:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.08));
            transform: translateY(-2px);
        }
        .admin-badge {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.05));
            border: 1px solid rgba(245, 158, 11, 0.3);
            color: #fbbf24;
        }
        .user-badge {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.05));
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #60a5fa;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in {
            animation: slideUp 0.6s ease-out forwards;
        }
    </style>
</head>
<body class="bg-zinc-950 min-h-screen text-white">

    <% if(error.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 z-50 bg-red-500/10 backdrop-blur-xl border border-red-500/20 text-red-400 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 animate-in">
        <span class="text-xl">⚠️</span>
        <div>
            <p class="font-semibold text-sm">Error</p>
            <p class="text-sm opacity-80"><%= error[0] %></p>
        </div>
    </div>
    <% } %>
    <% if(success.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 z-50 bg-emerald-500/10 backdrop-blur-xl border border-emerald-500/20 text-emerald-400 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 animate-in">
        <span class="text-xl">✅</span>
        <div>
            <p class="font-semibold text-sm">Success</p>
            <p class="text-sm opacity-80"><%= success[0] %></p>
        </div>
    </div>
    <% } %>

    <!-- Navbar -->
    <nav class="glass-nav sticky top-0 z-50 flex justify-between items-center px-6 lg:px-10 py-4">
        <div class="flex items-center gap-3">
            <!-- <div class="w-8 h-8 bg-gradient-to-br from-zinc-700 to-zinc-900 rounded-lg flex items-center justify-center font-bold border border-zinc-600 text-sm">
                E-C
            </div> -->
            <h1 class="text-xl font-bold tracking-tight">E-Commerce</h1>
        </div>
        <a href="/shop" class="flex items-center gap-2 text-zinc-400 hover:text-white transition px-4 py-2.5 rounded-xl hover:bg-zinc-800/50 border border-transparent hover:border-zinc-700">
            <span>←</span>
            <span>Back to Shop</span>
        </a>
    </nav>

    <!-- Profile Container -->
    <div class="max-w-4xl mx-auto mt-10 px-5 pb-16">

        <div class="profile-card rounded-3xl p-8 md:p-10 animate-in">

            <!-- Profile Header -->
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-10">

                <!-- Profile Picture -->
                <div class="flex flex-col items-center">
                    <div class="relative avatar-float">
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full blur-xl opacity-30"></div>
                        <img src="<%= user.profilepic ? `data:image/jpeg;base64,${user.profilepic.toString('base64')}` : 'https://ui-avatars.com/api/?name=User&background=18181b&color=ffffff&size=200' %>"
                            alt="Profile Picture"
                            class="relative w-36 h-36 rounded-full object-cover border-4 border-zinc-800 avatar-glow">
                        
                        <!-- Online Indicator -->
                        <div class="absolute bottom-2 right-2 w-5 h-5 bg-emerald-500 rounded-full border-4 border-zinc-900"></div>
                    </div>
                    
                    <a href="/profile/upload/<%= user._id%>" class="mt-5">
                        <button class="btn-secondary px-5 py-2.5 rounded-xl font-medium text-sm flex items-center gap-2">
                            <span>📷</span>
                            Change Picture
                        </button>
                    </a>
                </div>

                <!-- User Info -->
                <div class="flex-1 text-center md:text-left w-full">

                    <div class="mb-1">
                        <h2 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">
                            <%= user.fullname %>
                        </h2>
                    </div>

                    <p class="text-zinc-400 mb-6 flex items-center justify-center md:justify-start gap-2">
                        <span>📧</span>
                        <%= user.email %>
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                        <!-- Role -->
                        <div class="stat-card p-5 rounded-2xl">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-zinc-500 text-xs uppercase tracking-wider font-semibold">Role</p>
                                <span class="<%= userRole === 'admin' ? 'admin-badge' : 'user-badge' %> px-3 py-1 rounded-full text-xs font-bold">
                                    <%= userRole === 'admin' ? '👑 Admin' : '👤 User' %>
                                </span>
                            </div>
                            <p class="font-bold text-lg capitalize"><%= userRole %></p>
                            <% if(userRole === 'admin'){ %>
                            <a href="/owner/admin" class="inline-flex items-center gap-2 mt-3 text-amber-400 hover:text-amber-300 text-sm font-medium transition">
                                <span>⚡</span>
                                Go to Admin Panel →
                            </a>
                            <%}%>
                        </div>

                        <!-- Orders -->
                        <div class="stat-card p-5 rounded-2xl">
                            <div class="flex items-center justify-between mb-2">
                                <p class="text-zinc-500 text-xs uppercase tracking-wider font-semibold">Orders</p>
                                <span class="text-2xl">📦</span>
                            </div>
                            <p class="font-bold text-3xl"><%= user.orders.length %></p>
                            <p class="text-zinc-500 text-sm mt-1">Total Orders Placed</p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Action Buttons -->
            <div class="mt-10 pt-8 border-t border-zinc-800/60 flex flex-wrap gap-4 justify-center md:justify-start">

                <a href="/orders/<%= user._id%>" class="btn-primary px-8 py-3.5 rounded-2xl font-bold flex items-center gap-2">
                    <span>📋</span>
                    View Orders
                </a>

                <a href="/logout" class="btn-danger px-8 py-3.5 rounded-2xl font-bold flex items-center gap-2">
                    <span>🚪</span>
                    Logout
                </a>

            </div>

        </div>

        <!-- Quick Stats Row -->
        <div class="grid grid-cols-3 gap-4 mt-6">
            <div class="bg-zinc-900/50 border border-zinc-800/60 rounded-2xl p-5 text-center">
                <p class="text-2xl font-bold text-white"><%= user.orders.length %></p>
                <p class="text-zinc-500 text-xs mt-1 uppercase tracking-wider">Orders</p>
            </div>
            <div class="bg-zinc-900/50 border border-zinc-800/60 rounded-2xl p-5 text-center">
                <p class="text-2xl font-bold text-emerald-400">
                    ₹<%= user.orders.reduce((sum, o) => sum + Number(o.totalAmount), 0) %>
                </p>
                <p class="text-zinc-500 text-xs mt-1 uppercase tracking-wider">Spent</p>
            </div>
            <div class="bg-zinc-900/50 border border-zinc-800/60 rounded-2xl p-5 text-center">
                <p class="text-2xl font-bold text-blue-400">
                    <%= new Date().getFullYear() %>
                </p>
                <p class="text-zinc-500 text-xs mt-1 uppercase tracking-wider">Member Since</p>
            </div>
        </div>

    </div>

</body>
<script>
    setTimeout(() => {
        const msg = document.getElementById("flash-message");
        if (msg) msg.remove();
    }, 3000);
</script>
</html>