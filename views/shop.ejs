
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-950 text-white min-h-screen">

    <% if(error && error.length > 0){ %>
        <div id="flash-message" class="bg-red-100 text-red-700 p-3 rounded m-4">
            <%= error[0] %>
        </div>
    <% } %>

    <% if(success && success.length > 0){ %>
        <div id="flash-message" class="bg-green-100 text-green-700 p-3 rounded m-4">
            <%= success[0] %>
        </div>
    <% } %>

    <!-- Navbar -->
    <nav class="h-16 border-b border-zinc-800 flex items-center justify-between px-6 lg:px-10">

        <a href="/shop" class="text-2xl font-bold tracking-wide">
            E-Commerce
        </a>

        <!-- Search -->
        <form action="/shop" method="GET" class="flex-1 max-w-xl mx-6">

            <!-- Preserve filters -->
            <% if(instock){ %>
                <input type="hidden" name="instock" value="true">
            <% } %>

            <% if(discounted){ %>
                <input type="hidden" name="discounted" value="true">
            <% } %>

            <div class="relative">

                <input
                    type="text"
                    name="query"
                    value="<%= searchQuery || '' %>"
                    placeholder="Search products..."
                    class="w-full bg-zinc-900 border border-zinc-700 rounded-full py-2.5 pl-5 pr-12 text-sm focus:outline-none focus:border-white"
                >

                <button
                    type="submit"
                    class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-white"
                >
                    🔍
                </button>

            </div>

        </form>

        <div class="flex items-center gap-6">

            <a
                href="/cart/<%= user._id %>"
                class="hover:text-zinc-400 transition"
            >
                Cart
            </a>

            <a
                href="/profile/<%= user._id %>"
                class="hover:text-zinc-400 transition"
            >
                Profile
            </a>

        </div>

    </nav>

    <div class="flex">

        <!-- Sidebar -->
        <aside class="w-72 min-h-screen border-r border-zinc-800 p-8 hidden lg:block">

            <!-- Collections -->
            <div>

                <h3 class="font-semibold mb-4 text-lg">
                    Collections
                </h3>

                <div class="space-y-3">

                    <a
                        href="/shop"
                        class="block text-zinc-400 hover:text-white transition"
                    >
                        All Products
                    </a>

                    <a
                        href="/shop?discounted=true"
                        class="block text-zinc-400 hover:text-white transition"
                    >
                        Discounted Products
                    </a>

                </div>

            </div>

            <!-- Filters -->
            <div class="mt-12">

                <h3 class="font-semibold mb-4 text-lg">
                    Filters
                </h3>

                <form
                    id="filterForm"
                    action="/shop"
                    method="GET"
                    class="space-y-4"
                >

                    <!-- Preserve search query -->
                    <input
                        type="hidden"
                        name="query"
                        value="<%= searchQuery || '' %>"
                    >

                    <label class="flex items-center gap-2 cursor-pointer">

                        <input
                            type="checkbox"
                            name="instock"
                            value="true"
                            onchange="document.getElementById('filterForm').submit()"
                            <%= instock ? 'checked' : '' %>
                        >

                        In Stock

                    </label>

                    <label class="flex items-center gap-2 cursor-pointer">

                        <input
                            type="checkbox"
                            name="discounted"
                            value="true"
                            onchange="document.getElementById('filterForm').submit()"
                            <%= discounted ? 'checked' : '' %>
                        >

                        Discounted

                    </label>

                </form>

            </div>

        </aside>

        <!-- Products -->
        <main class="flex-1 p-6 lg:p-10">

            <% if(searchQuery){ %>

                <div class="mb-6">

                    <h2 class="text-2xl font-bold">
                        Search Results
                    </h2>

                    <p class="text-zinc-400 mt-1">
                        Showing results for
                        "<%= searchQuery %>"
                    </p>

                </div>

            <% } %>

            <% if(products.length === 0){ %>

                <div class="flex flex-col items-center justify-center py-24">

                    <div class="text-7xl">
                        🔍
                    </div>

                    <h2 class="text-3xl font-bold mt-4">
                        No Products Found
                    </h2>

                    <p class="text-zinc-400 mt-2">
                        Try changing your search or filters.
                    </p>

                </div>

            <% } else { %>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

                    <% products.forEach(function(product){ %>

                        <div class="bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 hover:border-zinc-600 transition flex flex-col">

                            <!-- Product Image -->
                            <div class="h-72 bg-zinc-800">

                                <img
                                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="<%= product.name %>"
                                    class="w-full h-full object-cover"
                                >

                            </div>

                            <!-- Product Content -->
                            <div class="p-4 flex flex-col flex-grow">

                                <h2 class="font-semibold text-lg min-h-[56px]">
                                    <%= product.name %>
                                </h2>

                                <!-- Price -->
                                <div class="mt-2">

                                    <% if(product.discount > 0){ %>

                                        <span class="line-through text-zinc-500">
                                            ₹<%= product.price %>
                                        </span>

                                        <span class="text-green-500 font-bold ml-2">
                                            ₹<%= Math.round(product.price - product.discount) %>
                                        </span>

                                    <% } else { %>

                                        <span class="font-semibold">
                                            ₹<%= product.price %>
                                        </span>

                                    <% } %>

                                </div>

                                <!-- Stock -->
                                <div class="mt-2">

                                    <% if(product.stock === 'Instock'){ %>

                                        <p class="text-green-400">
                                            ✓ In Stock
                                        </p>

                                    <% } else { %>

                                        <p class="text-red-400">
                                            ✗ Out Of Stock
                                        </p>

                                    <% } %>

                                </div>

                                <!-- Button -->
                                <div class="mt-auto pt-4">

                                    <% if(product.stock === 'Instock'){ %>

                                        <form
                                            action="/product/<%= product._id %>"
                                            method="POST"
                                        >

                                            <button
                                                type="submit"
                                                class="w-full bg-white text-black py-2.5 rounded-lg font-semibold hover:bg-zinc-200 transition"
                                            >
                                                Add To Cart
                                            </button>

                                        </form>

                                    <% } else { %>

                                        <form action="/outofstock">

                                            <button
                                                type="submit"
                                                class="w-full bg-zinc-700 text-zinc-400 py-2.5 rounded-lg font-semibold"
                                            >
                                                Out Of Stock
                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </main>

    </div>

    <script>
        setTimeout(() => {
            const msg = document.getElementById("flash-message");
            if (msg) {
                msg.remove();
            }
        }, 3000);
    </script>

</body>
</html>
