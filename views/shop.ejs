<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
        <link rel="icon" type="image/png" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        .glass-nav {
            background: rgba(9, 9, 11, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .search-input {
            background: rgba(39, 39, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
        }
        .search-input:focus {
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(39, 39, 42, 0.8);
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.05);
        }
        .product-card {
            background: linear-gradient(180deg, rgba(39, 39, 42, 0.5), rgba(24, 24, 27, 0.7));
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .product-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .product-image {
            transition: all 0.5s ease;
        }
        .product-card:hover .product-image {
            transform: scale(1.08);
        }
        .discount-badge {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 4px 15px -3px rgba(239, 68, 68, 0.4);
        }
        .add-to-cart-btn {
            background: linear-gradient(135deg, #ffffff, #e4e4e7);
            transition: all 0.3s ease;
        }
        .add-to-cart-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(255, 255, 255, 0.2);
        }
        .sidebar-link {
            transition: all 0.2s ease;
        }
        .sidebar-link:hover {
            padding-left: 0.75rem;
        }
        .filter-checkbox {
            accent-color: #22c55e;
        }
        .stock-badge {
            backdrop-filter: blur(8px);
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 3px;
        }
    </style>
</head>

<body class="bg-zinc-950 text-white min-h-screen">

    <% if(error && error.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 z-50 bg-red-500/10 backdrop-blur-xl border border-red-500/20 text-red-400 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 animate-in">
        <span class="text-xl">⚠️</span>
        <div>
            <p class="font-semibold text-sm">Error</p>
            <p class="text-sm opacity-80"><%= error[0] %></p>
        </div>
    </div>
    <% } %>

    <% if(success && success.length > 0){ %>
    <div id="flash-message" class="fixed top-6 right-6 z-50 bg-emerald-500/10 backdrop-blur-xl border border-emerald-500/20 text-emerald-400 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 animate-in">
        <span class="text-xl">✅</span>
        <div>
            <p class="font-semibold text-sm">Success</p>
            <p class="text-sm opacity-80"><%= success[0] %></p>
        </div>
    </div>
    <% } %>

    <!-- Navbar -->
    <nav class="glass-nav sticky top-0 z-50 h-16 flex items-center justify-between px-6 lg:px-10">

        <a href="/shop" class="text-2xl font-bold tracking-tight bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">
            E-Commerce
        </a>

        <!-- Search -->
        <form action="/shop" method="GET" class="flex-1 max-w-xl mx-6 hidden md:block">
            <% if(instock){ %>
                <input type="hidden" name="instock" value="true">
            <% } %>
            <% if(discounted){ %>
                <input type="hidden" name="discounted" value="true">
            <% } %>
            <div class="relative group">
                <input type="text" name="query" value="<%= searchQuery || '' %>" placeholder="Search products..."
                    class="search-input w-full rounded-full py-2.5 pl-12 pr-12 text-sm text-white placeholder-zinc-500 outline-none">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 group-focus-within:text-white transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-white transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </form>

        <div class="flex items-center gap-2">
            <a href="/cart/<%= user._id %>" class="flex items-center gap-2 px-4 py-2 rounded-xl hover:bg-zinc-800/50 transition text-zinc-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span class="hidden sm:inline">Cart</span>
            </a>
            <a href="/profile/<%= user._id %>" class="flex items-center gap-2 px-4 py-2 rounded-xl hover:bg-zinc-800/50 transition text-zinc-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span class="hidden sm:inline">Profile</span>
            </a>
        </div>

    </nav>

    <div class="flex">

        <!-- Sidebar -->
        <aside class="w-72 min-h-screen border-r border-zinc-800/60 p-8 hidden lg:block custom-scrollbar overflow-y-auto">

            <!-- Collections -->
            <div>
                <h3 class="font-bold mb-5 text-lg flex items-center gap-2">
                    <span class="w-8 h-8 bg-zinc-800 rounded-lg flex items-center justify-center text-sm">🏷️</span>
                    Collections
                </h3>
                <div class="space-y-2">
                    <a href="/shop" class="sidebar-link block text-zinc-400 hover:text-white transition py-2.5 px-3 rounded-xl hover:bg-zinc-800/50 <%= !instock && !discounted ? 'bg-zinc-800/30 text-white' : '' %>">
                        All Products
                    </a>
                    <a href="/shop?discounted=true" class="sidebar-link block text-zinc-400 hover:text-white transition py-2.5 px-3 rounded-xl hover:bg-zinc-800/50 <%= discounted ? 'bg-zinc-800/30 text-white' : '' %>">
                        🔥 Discounted Products
                    </a>
                </div>
            </div>

            <!-- Filters -->
            <div class="mt-10">
                <h3 class="font-bold mb-5 text-lg flex items-center gap-2">
                    <span class="w-8 h-8 bg-zinc-800 rounded-lg flex items-center justify-center text-sm">⚙️</span>
                    Filters
                </h3>
                <form id="filterForm" action="/shop" method="GET" class="space-y-3">
                    <input type="hidden" name="query" value="<%= searchQuery || '' %>">

                    <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl hover:bg-zinc-800/30 transition group">
                        <div class="relative">
                            <input type="checkbox" name="instock" value="true" onchange="document.getElementById('filterForm').submit()" <%= instock ? 'checked' : '' %> class="filter-checkbox w-5 h-5 rounded border-zinc-600 bg-zinc-800">
                        </div>
                        <span class="text-zinc-400 group-hover:text-white transition">In Stock Only</span>
                    </label>

                    <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl hover:bg-zinc-800/30 transition group">
                        <div class="relative">
                            <input type="checkbox" name="discounted" value="true" onchange="document.getElementById('filterForm').submit()" <%= discounted ? 'checked' : '' %> class="filter-checkbox w-5 h-5 rounded border-zinc-600 bg-zinc-800">
                        </div>
                        <span class="text-zinc-400 group-hover:text-white transition">On Sale</span>
                    </label>
                </form>
            </div>

            <!-- Mini Stats -->
            <div class="mt-10 p-5 bg-zinc-900/50 rounded-2xl border border-zinc-800/60">
                <p class="text-zinc-500 text-xs uppercase tracking-wider font-semibold mb-3">Store Stats</p>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-zinc-400">Products</span>
                        <span class="font-bold"><%= products.length %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-400">In Stock</span>
                        <span class="text-emerald-400 font-bold"><%= products.filter(p => p.stock === 'Instock').length %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-zinc-400">On Sale</span>
                        <span class="text-red-400 font-bold"><%= products.filter(p => p.discount > 0).length %></span>
                    </div>
                </div>
            </div>

        </aside>

        <!-- Products -->
        <main class="flex-1 p-6 lg:p-10">

            <% if(searchQuery){ %>
            <div class="mb-8 animate-in">
                <h2 class="text-3xl font-bold bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">Search Results</h2>
                <p class="text-zinc-500 mt-2 flex items-center gap-2">
                    <span>🔍</span>
                    Showing results for "<span class="text-white font-semibold"><%= searchQuery %></span>"
                </p>
            </div>
            <% } %>

            <% if(products.length === 0){ %>

                <div class="flex flex-col items-center justify-center py-32 animate-in">
                    <div class="text-8xl mb-6 opacity-50">🔍</div>
                    <h2 class="text-3xl font-bold mb-3">No Products Found</h2>
                    <p class="text-zinc-500 text-lg">Try changing your search or filters.</p>
                    <a href="/shop" class="mt-8 px-6 py-3 bg-zinc-800 rounded-xl hover:bg-zinc-700 transition text-sm font-semibold">
                        Clear Filters
                    </a>
                </div>

            <% } else { %>

                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6">

                    <% products.forEach(function(product, idx){ %>

                        <div class="product-card rounded-2xl overflow-hidden flex flex-col animate-in" style=`animation-delay: ${<%= idx * 0.05 %>}s`>

                            <!-- Product Image -->
                            <div class="h-72 bg-zinc-800 relative overflow-hidden group">
                                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                    alt="<%= product.name %>"
                                    class="product-image w-full h-full object-cover">
                                
                                <!-- Overlay on hover -->
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                                <% if(product.discount > 0){ %>
                                <div class="absolute top-4 left-4 discount-badge text-white px-3 py-1.5 rounded-full text-xs font-bold">
                                    −<%= Math.round((product.discount / product.price) * 100) %>%
                                </div>
                                <% } %>

                                <div class="absolute top-4 right-4">
                                    <% if(product.stock === 'Instock'){ %>
                                        <span class="stock-badge bg-emerald-500/90 text-white px-3 py-1.5 rounded-full text-xs font-bold">
                                            ✓ In Stock
                                        </span>
                                    <% } else { %>
                                        <span class="stock-badge bg-red-500/90 text-white px-3 py-1.5 rounded-full text-xs font-bold">
                                            ✗ Out of Stock
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Product Content -->
                            <div class="p-5 flex flex-col flex-grow">

                                <h2 class="font-bold text-lg text-white mb-2 line-clamp-2 min-h-[3.5rem]">
                                    <%= product.name %>
                                </h2>

                                <!-- Price -->
                                <div class="flex items-end gap-3 mb-3">
                                    <% if(product.discount > 0){ %>
                                        <span class="text-2xl font-bold text-emerald-400">
                                            ₹<%= Math.round(product.price - product.discount) %>
                                        </span>
                                        <span class="text-sm text-zinc-500 line-through mb-1">
                                            ₹<%= product.price %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-2xl font-bold text-white">
                                            ₹<%= product.price %>
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Stock -->
                                <div class="mb-auto">
                                    <% if(product.stock === 'Instock'){ %>
                                        <p class="text-emerald-400 text-sm flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                                            Available Now
                                        </p>
                                    <% } else { %>
                                        <p class="text-red-400 text-sm flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span>
                                            Currently Unavailable
                                        </p>
                                    <% } %>
                                </div>

                                <!-- Button -->
                                <div class="mt-5">
                                    <% if(product.stock === 'Instock'){ %>
                                        <form action="/product/<%= product._id %>" method="POST">
                                            <button type="submit" class="add-to-cart-btn w-full text-black py-3 rounded-xl font-bold flex items-center justify-center gap-2">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                                </svg>
                                                Add to Cart
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/outofstock">
                                            <button type="submit" disabled class="w-full bg-zinc-800 text-zinc-500 py-3 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2 border border-zinc-700">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                                                </svg>
                                                Out of Stock
                                            </button>
                                        </form>
                                    <% } %>
                                </div>

                            </div>
                        </div>

                    <% }) %>

                </div>

            <% } %>

        </main>

    </div>

    <script>
        setTimeout(() => {
            const msg = document.getElementById("flash-message");
            if (msg) msg.remove();
        }, 3000);
    </script>

</body>
</html>